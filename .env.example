# Microcontroller URL — use mock_mc.py for local testing (no hardware needed)
# MC_URL=http://192.168.1.100/data   ← real hardware
MC_URL=http://localhost:8001/data    ← mock server

# How often to poll the default device (seconds)
MC_POLL_INTERVAL=5

# HTTP request timeout (seconds)
MC_TIMEOUT=3

# SQLite (default) — swap for postgres://user:pass@host/db for production
DATABASE_URL=sqlite:///./broker.db

# API bind address and port
API_HOST=0.0.0.0
API_PORT=8000

# Max readings stored per device (0 = unlimited)
MAX_READINGS_PER_DEVICE=10000

# MQTT (optional) — set MQTT_ENABLED=true to receive data via Mosquitto
# Devices publish to topic:  iot/devices/{device_name}/data
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=iot/devices
MQTT_USERNAME=
MQTT_PASSWORD=
